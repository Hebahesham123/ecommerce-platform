# Two ways to run, chosen by DB_API_HOST in .env:
#
#   DB_API_HOST=srv2120209.hstgr.cloud   Direct: Caddy gets a free HTTPS certificate for that address
#                                        and serves it on ports 80/443. (No own domain yet.)
#   DB_API_HOST unset                    Tunnel: plain port 80 inside Docker; Cloudflare Tunnel
#                                        handles HTTPS. (Once the store has a domain on Cloudflare.)
{$DB_API_HOST::80} {
	# Security step 1.8: record who calls the database API from outside, so every caller can be
	# made to send the gate header before Caddy starts requiring it (1.10, 1.11). Only /rest/v1
	# requests are logged; the key headers are removed from the log.
	# Read it with: docker compose exec caddy cat /data/access-rest.log
	log {
		output file /data/access-rest.log {
			roll_size 20MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>headers>Apikey delete
				request>headers>Authorization delete
				request>headers>X-Store-Gate delete
				request>headers>Cookie delete
			}
		}
	}
	@not_db_api not path /rest/v1/*
	log_skip @not_db_api

	# Security step 1.1 (temporary, until staff login 3.3 works): a password in front of the
	# dashboard. Removed in step 3.6. Paths come from BeautyBar-H1-Admin-Paths.md.
	# ADMIN_GATE_USER / ADMIN_GATE_HASH come from /opt/store/.env; the hash is
	# `caddy hash-password` output, base64-encoded (no "$" for docker compose to eat).
	@admin {
		path /
		path /dashboard /dashboard/* /orders /orders/* /products /products/*
		path /collections /collections/* /inventory /inventory/* /customers /customers/*
		path /discounts /discounts/* /payments /payments/* /settings /settings/*
		path /accounting /accounting/* /analytics /analytics/* /marketing /marketing/*
		path /email /email/* /blog /blog/* /pages /pages/* /content /content/*
		path /navigation /navigation/* /online-store /online-store/* /seo /seo/*
		path /channels /channels/* /inbox /inbox/* /lives /lives/* /loyalty /loyalty/*
		path /nudges /nudges/* /requests /requests/* /returns /returns/* /reviews /reviews/*
		path /couriers /couriers/* /courier-system /courier-system/* /app /app/*
		path /app-preview /app-preview/* /api/meta/connect /api/meta/callback
	}
	# Dashboard buttons are server actions (POST + Next-Action header). Customers' actions are
	# posted only from /store/* and /courier, so an action posted anywhere else needs the password.
	@admin_action {
		header Next-Action *
		not path /store /store/* /courier /courier/*
	}
	basic_auth @admin {
		{$ADMIN_GATE_USER} {$ADMIN_GATE_HASH}
	}
	basic_auth @admin_action {
		{$ADMIN_GATE_USER} {$ADMIN_GATE_HASH}
	}

	# supabase-js calls <url>/rest/v1/<table>; PostgREST expects /<table>.
	handle_path /rest/v1/* {
		reverse_proxy postgrest:3000
	}

	# Public files (product images, theme assets, avatars, videos): read-only.
	# /media/<folder>/<file>  →  file store bucket "store-media"/<folder>/<file>
	handle_path /media/* {
		@notread not method GET HEAD
		respond @notread "read only" 405
		rewrite * /store-media{path}
		reverse_proxy files:8333
		header ?Cache-Control "public, max-age=86400"
	}

	# For uptime monitoring.
	handle /health {
		respond "ok" 200
	}

	# Live-stream chat stays open and streams: straight to the website, no cache, no compression.
	@livestream path_regexp livestream ^/api/storefront/lives/[^/]+/stream$
	handle @livestream {
		reverse_proxy web:3000 {
			flush_interval -1
		}
	}

	# Everything else is the store website (through the page cache).
	handle {
		encode zstd gzip
		reverse_proxy cache:80
	}

	header -Server
}

# File uploads (S3 API, needs the secret key). Same certificate, port 9443.
# Caddy passes the Host header through unchanged, which S3 signatures depend on.
{$DB_API_HOST}:9443 {
	# Browsers upload big videos straight here with a one-time signed address, so allow
	# cross-site requests. The signature, not the origin, is what grants access.
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, PUT, HEAD, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "*"
		header Access-Control-Max-Age "86400"
		respond 204
	}
	handle {
		reverse_proxy files:8333 {
			header_down Access-Control-Allow-Origin "*"
			header_down Access-Control-Expose-Headers "ETag"
		}
	}
	header -Server
}

# Inside Docker only: the website reaches the database here directly, without leaving the server.
http://caddy:8080 {
	handle_path /rest/v1/* {
		reverse_proxy postgrest:3000
	}
	respond 404
}
