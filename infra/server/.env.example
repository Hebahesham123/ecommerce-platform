# Copy to /opt/store/.env on the server and fill in. Never commit the real file.
# Generate long random passwords with:  openssl rand -base64 36

POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=

# From: node scripts/make-jwt-keys.mjs   (run on your own computer)
JWT_SECRET=

# Direct mode (no own domain yet): the server's address. Caddy gets an HTTPS certificate for it.
# Leave empty when using the Cloudflare Tunnel instead.
DB_API_HOST=

# Tunnel mode only. Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token
CLOUDFLARE_TUNNEL_TOKEN=

# Backups (scripts/backup.sh) — the rclone remote name and R2 bucket for backups
BACKUP_REMOTE=r2
BACKUP_BUCKET=store-backups
# Optional: a URL to ping after each successful backup (Uptime Kuma / Better Stack heartbeat)
BACKUP_PING_URL=

# Garnet cache (only needed with --profile cache)
GARNET_PASSWORD=
GARNET_CERT_PASSWORD=
